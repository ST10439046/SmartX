# Smart-X IoT Frontend - Environment Configuration

# API Configuration
VITE_API_BASE_URL=http://localhost:5231

# Application Settings
VITE_APP_NAME=Smart-X IoT Platform
VITE_APP_VERSION=1.0.0

# Feature Flags
VITE_ENABLE_TELEMETRY_DASHBOARD=true
VITE_ENABLE_COMMAND_STREAM=false
VITE_ENABLE_TOPOLOGY_VIEW=false

# Upload Configuration
VITE_MAX_FILE_SIZE=52428800  # 50MB in bytes
VITE_ALLOWED_FILE_TYPES=json,xml,csv,log,jpg,jpeg,png,pdf

# UI Configuration
VITE_DARK_MODE_DEFAULT=auto  # auto | light | dark
VITE_TOAST_DURATION=5000     # milliseconds

# Logging
VITE_DEBUG_MODE=false
VITE_LOG_LEVEL=info          # debug | info | warn | error
